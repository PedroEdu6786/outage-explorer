EIA_API_KEY=

# Configured S3 target for default connector runs and explicit persist/recover.
# Use --local-only (Make: LOCAL_ONLY=1) without AWS; no automatic .env loading.
# AWS_PROFILE is for local development; deployed workloads should use a role.
AWS_PROFILE=outage-explorer
AWS_REGION=us-east-1
OUTAGE_S3_BUCKET=arkham-outage-explorer
OUTAGE_S3_PREFIX=data/
# Cognito setup completed by user; supply the current identifiers locally.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# RDS connection completed by user; supply environment-specific settings locally.
# Supply credentials locally or through a secret manager, never in Git.
PGHOST=
PGPORT=5432
PGDATABASE=outage_explorer
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=

# Connector concurrency is optional JSON, never a credential/environment override.
# --config file may contain {"workers":{"endpoint_workers":3,"s3_workers":3}}.
# Page/endpoint defaults are sequential; S3 resources default to3 workers.
# These logical allowances are not measured production capacity.
# Typed defaults admit 183 days with a 1,800-second candidate budget; JSON overrides
# remain optional. See ADR-0048; EIA/S3 variables must be exported by the caller.

# Auth HTTP is opt-in; false preserves credential-free health-only startup.
OUTAGE_AUTH_ENABLED=false
# Same access store as the explicit migration/seed CLI. Export locally; never commit secrets.
OUTAGE_ACCESS_DATABASE_DSN=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_OAUTH_SCOPES=
# Optional resource audience, only if the configured client issues it.
COGNITO_RESOURCE=
# Production origins use HTTPS; callback is PUBLIC_ORIGIN + /api/auth/callback.
OUTAGE_AUTH_PUBLIC_ORIGIN=
OUTAGE_AUTH_CALLBACK_URI=
# Defaults to PUBLIC_ORIGIN for a same-origin proxy; cross-origin UI must be explicit.
OUTAGE_AUTH_UI_ORIGIN=
OUTAGE_AUTH_RETURN_PATHS=/
# true permits insecure cookies only with explicit loopback HTTP origins.
OUTAGE_AUTH_DEVELOPMENT_HTTP=false
OUTAGE_AUTH_SESSION_SECONDS=3600
OUTAGE_AUTH_ATTEMPT_SECONDS=600
OUTAGE_AUTH_ATTEMPT_LIMIT=1000

# Product refresh transfer count is frozen at admission;1–3, default3.
OUTAGE_REFRESH_S3_WORKERS=3
