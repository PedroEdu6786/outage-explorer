EIA_API_KEY=

# Confirmed development/demo AWS target. Connector adapters are not wired yet.
# AWS_PROFILE is for local development; deployed workloads should use a role.
AWS_PROFILE=outage-explorer
AWS_REGION=us-east-1
OUTAGE_S3_BUCKET=arkham-outage-explorer
OUTAGE_S3_PREFIX=data/
# Deferred; previous pool identifier removed at user request.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Deferred by user: no RDS instance exists in the target region.
# Supply credentials locally or through a secret manager, never in Git.
PGHOST=
PGPORT=5432
PGDATABASE=outage_explorer
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=
